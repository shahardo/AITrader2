# .env.example — copy to .env and fill in secrets. Never commit .env.
# For non-Docker backend dev, also copy this file to backend/.env (see README) —
# pydantic-settings loads .env relative to the working directory.

# Security — REQUIRED: set a long random string in any real deployment
JWT_SECRET=change-me-to-a-long-random-string                # use "python -c 'import secrets; print(secrets.token_hex(32))'" to generate a random string

# Groq LLM (paid plan) — required from Milestone 2 onward
GROQ_API_KEY=

# Telegram bot token from @BotFather — empty disables Telegram notifications
TELEGRAM_BOT_TOKEN=

# Overridden automatically inside docker compose; set these for bare-metal runs.
# DATABASE_URL must point at a database that already exists — see README
# "Development without Docker" for how to create it.
# DATABASE_URL=postgresql+psycopg://aitrader:aitrader@localhost:5432/aitrader
# REDIS_URL=redis://localhost:6379/0

# Frontend origin allowed by CORS
CORS_ORIGINS=http://localhost:5173

ENVIRONMENT=dev
